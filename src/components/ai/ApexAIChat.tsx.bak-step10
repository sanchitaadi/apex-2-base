"use client";

import { FormEvent, useState } from "react";
import { usePathname } from "next/navigation";
import {
  Send,
  Sparkles,
  X,
  Loader2,
} from "lucide-react";

type Message = {
  role: "user" | "assistant";
  content: string;
};

const quickQuestions = [
  "How can I apply for admission?",
  "What are the school timings?",
  "What documents are required for admission?",
];

/* =========================================================
   FORMAT AI MESSAGE
========================================================= */

function formatMessage(text: string) {
  const lines = text.split("\n");

  return lines.map((line, index) => {
    const trimmed = line.trim();

    if (!trimmed) {
      return (
        <div
          key={index}
          className="h-2"
        />
      );
    }

    /* -----------------------------------------------------
       BULLET POINT
    ----------------------------------------------------- */

    const bulletMatch =
      trimmed.match(/^[-•*]\s+(.*)$/);

    if (bulletMatch) {
      return (
        <div
          key={index}
          className="flex gap-2 py-0.5"
        >
          <span className="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#C9A227]" />

          <span>
            {formatInlineText(
              bulletMatch[1]
            )}
          </span>
        </div>
      );
    }

    /* -----------------------------------------------------
       NORMAL LINE
    ----------------------------------------------------- */

    return (
      <div key={index}>
        {formatInlineText(trimmed)}
      </div>
    );
  });
}

/* =========================================================
   FORMAT BOLD + LINKS
========================================================= */

function formatInlineText(text: string) {
  const parts: React.ReactNode[] = [];

  /*
   * Matches:
   * [View Document](https://example.com)
   */

  const markdownLinkRegex =
    /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;

  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while (
    (match = markdownLinkRegex.exec(text)) !== null
  ) {
    /* Text before link */

    if (match.index > lastIndex) {
      parts.push(
        ...formatBoldText(
          text.slice(
            lastIndex,
            match.index
          ),
          `text-${lastIndex}`
        )
      );
    }

    const label = match[1];
    const url = match[2];

    parts.push(
      <a
        key={`link-${match.index}`}
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        className="my-1 inline-flex max-w-full items-center rounded-lg border border-[#D9C9A8] bg-[#F8F3E8] px-3 py-1.5 text-xs font-semibold text-[#102A56] transition hover:bg-[#F0E5CC]"
      >
        <span className="truncate">
          {label}
        </span>

        <span className="ml-1.5 shrink-0">
          ↗
        </span>
      </a>
    );

    lastIndex =
      match.index + match[0].length;
  }

  /* Remaining text */

  if (lastIndex < text.length) {
    parts.push(
      ...formatBoldText(
        text.slice(lastIndex),
        `remaining-${lastIndex}`
      )
    );
  }

  return parts.length > 0
    ? parts
    : formatBoldText(
        text,
        "full"
      );
}

/* =========================================================
   FORMAT **BOLD** TEXT
========================================================= */

function formatBoldText(
  text: string,
  keyPrefix: string
) {
  const parts =
    text.split(/(\*\*.*?\*\*)/g);

  return parts.map(
    (part, index) => {
      if (
        part.startsWith("**") &&
        part.endsWith("**") &&
        part.length >= 4
      ) {
        return (
          <strong
            key={`${keyPrefix}-bold-${index}`}
            className="font-semibold text-[#102A56]"
          >
            {part.slice(2, -2)}
          </strong>
        );
      }

      /*
       * Prevent long URLs/text from
       * creating horizontal scrolling.
       */

      return (
        <span
          key={`${keyPrefix}-text-${index}`}
          className="break-words"
        >
          {part}
        </span>
      );
    }
  );
}

export default function ApexAIChat() {
  const pathname = usePathname();

  /* -------------------------------------------------------
     NEVER SHOW AI INSIDE ADMIN
  ------------------------------------------------------- */

  if (
    pathname === "/admin" ||
    pathname.startsWith("/admin/")
  ) {
    return null;
  }

  const [isOpen, setIsOpen] =
    useState(false);

  const [messages, setMessages] =
    useState<Message[]>([
      {
        role: "assistant",
        content:
          "Hello! 👋 I'm Ask Apex AI. I can help you with admissions, school timings, documents, notices and other information about Apex Public School.",
      },
    ]);

  const [input, setInput] =
    useState("");

  const [loading, setLoading] =
    useState(false);

  /* =======================================================
     SEND MESSAGE
  ======================================================= */

  async function sendMessage(
    messageText?: string
  ) {
    const text =
      (messageText ?? input).trim();

    if (!text || loading) {
      return;
    }

    setInput("");

    /*
     * Add user message immediately
     */

    const updatedMessages: Message[] = [
      ...messages,
      {
        role: "user",
        content: text,
      },
    ];

    setMessages(
      updatedMessages
    );

    setLoading(true);

    try {
      const response =
        await fetch(
          "/api/chat",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body: JSON.stringify({
              /*
               * Send conversation history
               * to the API.
               */
              messages:
                updatedMessages,
            }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data?.error ||
            "Unable to get a response."
        );
      }

      setMessages(
        (prev) => [
          ...prev,
          {
            role: "assistant",
            content:
              data.answer ||
              "I'm sorry, I couldn't find an answer right now.",
          },
        ]
      );
    } catch (error) {
      console.error(
        "Ask Apex AI:",
        error
      );

      setMessages(
        (prev) => [
          ...prev,
          {
            role: "assistant",
            content:
              "I'm sorry, I'm having trouble connecting right now. Please try again in a moment.",
          },
        ]
      );
    } finally {
      setLoading(false);
    }
  }

  /* =======================================================
     FORM SUBMIT
  ======================================================= */

  function handleSubmit(
    e: FormEvent<HTMLFormElement>
  ) {
    e.preventDefault();

    sendMessage();
  }

  return (
    <>
      {/* =====================================================
          CHAT WINDOW
      ===================================================== */}

      {isOpen && (
        <div className="fixed bottom-24 right-6 z-[999] w-[calc(100vw-32px)] max-w-[390px] overflow-hidden rounded-2xl border border-[#D9C9A8] bg-[#FBF8F1] shadow-2xl">

          {/* =================================================
              HEADER
          ================================================= */}

          <div className="flex items-center justify-between bg-[#102A56] px-5 py-4 text-white">

            <div className="flex items-center gap-3">

              <div className="flex h-10 w-10 items-center justify-center rounded-full bg-[#C9A227] text-[#102A56]">
                <Sparkles size={20} />
              </div>

              <div>
                <h3 className="text-sm font-semibold">
                  Ask Apex AI
                </h3>

                <p className="text-[11px] text-white/70">
                  Apex Public School Assistant
                </p>
              </div>

            </div>

            <button
              type="button"
              onClick={() =>
                setIsOpen(false)
              }
              className="rounded-full p-2 transition hover:bg-white/10"
              aria-label="Close chat"
            >
              <X size={20} />
            </button>

          </div>

          {/* =================================================
              MESSAGES
          ================================================= */}

          <div className="h-[390px] space-y-4 overflow-x-hidden overflow-y-auto px-4 py-4">

            {messages.map(
              (message, index) => {
                const isUser =
                  message.role ===
                  "user";

                return (
                  <div
                    key={index}
                    className={`flex ${
                      isUser
                        ? "justify-end"
                        : "justify-start"
                    }`}
                  >

                    <div
                      className={`max-w-[88%] overflow-hidden rounded-2xl px-4 py-3 text-sm leading-6 ${
                        isUser
                          ? "rounded-br-md bg-[#102A56] text-white"
                          : "rounded-bl-md border border-[#E5DCCB] bg-white text-[#26364D]"
                      }`}
                    >

                      {isUser ? (
                        <div className="whitespace-pre-wrap break-words">
                          {message.content}
                        </div>
                      ) : (
                        <div className="break-words">
                          {formatMessage(
                            message.content
                          )}
                        </div>
                      )}

                    </div>

                  </div>
                );
              }
            )}

            {/* =================================================
                THINKING
            ================================================= */}

            {loading && (
              <div className="flex justify-start">

                <div className="flex items-center gap-2 rounded-2xl rounded-bl-md border border-[#E5DCCB] bg-white px-4 py-3 text-sm text-[#526173]">

                  <Loader2
                    size={16}
                    className="animate-spin"
                  />

                  Thinking...

                </div>

              </div>
            )}

          </div>

          {/* =================================================
              QUICK QUESTIONS
          ================================================= */}

          {messages.length === 1 &&
            !loading && (
              <div className="border-t border-[#E5DCCB] px-4 py-3">

                <p className="mb-2 text-[11px] font-medium uppercase tracking-wide text-[#7A6B55]">
                  Quick questions
                </p>

                <div className="flex flex-wrap gap-2">

                  {quickQuestions.map(
                    (question) => (
                      <button
                        key={question}
                        type="button"
                        onClick={() =>
                          sendMessage(
                            question
                          )
                        }
                        className="rounded-full border border-[#D9C9A8] bg-white px-3 py-2 text-left text-xs text-[#102A56] transition hover:bg-[#F3EBD9]"
                      >
                        {question}
                      </button>
                    )
                  )}

                </div>

              </div>
            )}

          {/* =================================================
              INPUT
          ================================================= */}

          <form
            onSubmit={handleSubmit}
            className="border-t border-[#E5DCCB] bg-white p-3"
          >

            <div className="flex items-center gap-2 rounded-xl border border-[#D9C9A8] bg-[#FBF8F1] px-3 py-1">

              <input
                type="text"
                value={input}
                onChange={(e) =>
                  setInput(
                    e.target.value
                  )
                }
                placeholder="Ask about Apex Public School..."
                disabled={loading}
                className="min-w-0 flex-1 bg-transparent py-2.5 text-sm text-[#102A56] outline-none placeholder:text-[#8B8172]"
              />

              <button
                type="submit"
                disabled={
                  !input.trim() ||
                  loading
                }
                className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#C9A227] text-[#102A56] transition hover:scale-105 disabled:cursor-not-allowed disabled:opacity-40"
                aria-label="Send message"
              >
                <Send size={17} />
              </button>

            </div>

          </form>

        </div>
      )}

      {/* =====================================================
          FLOATING ASK APEX AI BUTTON
      ===================================================== */}

      {!isOpen && (
        <button
          type="button"
          onClick={() =>
            setIsOpen(true)
          }
          className="fixed bottom-24 right-6 z-[998] flex items-center gap-2 rounded-full bg-[#102A56] px-5 py-3.5 text-sm font-semibold text-white shadow-xl transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl"
          aria-label="Open Ask Apex AI"
        >

          <Sparkles
            size={18}
            className="text-[#C9A227]"
          />

          <span>
            Ask Apex AI
          </span>

        </button>
      )}

    </>
  );
}
